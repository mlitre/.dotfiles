#!/bin/bash
# CPU (since the previous run), CPU temperature and memory use, for an Omarchy bar command module.

state="${XDG_RUNTIME_DIR:-/tmp}/omarchy-bar-cpu"

while IFS=$'\t' read -r key a b; do
  case $key in
    cpu) idle=$a total=$b ;;
    memory) mem=$a ;;
    load) load=$a ;;
  esac
done < <(omarchy-system-stats --bar-widget)

read -r prev_idle prev_total 2>/dev/null < "$state" || true
echo "$idle $total" > "$state"

cpu=0
if [[ -n $prev_total ]] && (( total > prev_total )); then
  cpu=$(( 100 * ((total - prev_total) - (idle - prev_idle)) / (total - prev_total) ))
fi

# hwmon numbering changes across boots, so find the CPU sensor by driver name.
temp="" temp_tip=""
for h in /sys/class/hwmon/hwmon*; do
  case $(<"$h/name") in
    k10temp | coretemp)
      temp=" $(( $(<"$h/temp1_input") / 1000 ))°C"
      temp_tip="  ·  Temp${temp}"
      break
      ;;
  esac
done

printf '{"text":"󰍛 %d%%%s  󰘚 %.0f%%","tooltip":"CPU %d%%%s  ·  Memory %.0f%%  ·  Load %s"}\n' \
  "$cpu" "$temp" "$mem" "$cpu" "$temp_tip" "$mem" "$load"
