# Ghostty — Martin's config (transparent, JetBrainsMono NF)
# Colours are generated by Noctalia into ~/.config/ghostty/themes/noctalia and
# follow `dot theme`. Ghostty falls back to defaults until the first templates-apply.

theme = noctalia

font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = -calt

background-opacity = 0.85
background-blur = true
unfocused-split-opacity = 0.8

window-decoration = none
gtk-titlebar = false
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
confirm-close-surface = false

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-paste-protection = false

shell-integration = zsh
shell-integration-features = cursor,sudo,title
scrollback-limit = 20000000

# herdr uses ctrl+b as prefix; keep Ghostty's own splits off that key.
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
